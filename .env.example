# База для деплоя (GitHub Pages ставит приложение в подпапку /<repo>/).
# Локально не нужна: по умолчанию base = '/'.
# VITE_BASE=/codequest/

# ============================================================
# Бесплатное облако Supabase (для онлайн-авторизации и синхронизации)
# Задаются только создателем проекта (в .env или в настройках деплоя).
# Пользователям вводить ничего не нужно — они сразу регистрируются и входят.
# ============================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
